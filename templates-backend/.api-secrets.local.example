# Credenciales y configuración de los tests de API.
#
#   cp .api-secrets.local.example .api-secrets.local
#
# `.api-secrets.local` está gitignoreado y NUNCA se commitea.
#
# ⚠️ Reglas (§12 del estándar):
#   · Sólo ambientes de PRUEBA. Nunca producción.
#   · Nunca tus credenciales personales: un usuario de servicio por rol.
#     Si un test falla por permisos, hay que poder saber de quién es el permiso.
#   · Si no sabés qué va acá, preguntá — no lo inventes.

# ─── Servicio bajo prueba ───────────────────────────────────────────────────
API_BASE_URL=http://localhost:3000

# Ruta del health check. Se consulta una vez al arrancar la suite.
# API_RUTA_SALUD=/api/salud

# ─── Contrato ───────────────────────────────────────────────────────────────
# Ruta al OpenAPI/JSON Schema del proyecto.
# Poner `ninguno` SÓLO si el proyecto todavía no tiene contrato: la dimensión
# D1 queda sin cubrir y así se anota en el reporte.
API_CONTRATO=openapi.yaml

# Afloja la validación estricta (permite campos no declarados). Usar sólo
# durante la adopción, y con fecha de vencimiento.
# API_CONTRATO_LAXO=1

# ─── Identidades ────────────────────────────────────────────────────────────
# Una por rol. `otroUsuario` y `otroTenant` NO son opcionales: sin una segunda
# identidad no se puede probar IDOR, y sin IDOR la suite de seguridad decora.

API_USER_ADMIN=
API_PASS_ADMIN=

API_USER_OPERADOR=
API_PASS_OPERADOR=

API_USER_LECTOR=
API_PASS_LECTOR=

# Usuario del mismo tenant, SIN acceso a los recursos del operador.
API_USER_OTROUSUARIO=
API_PASS_OTROUSUARIO=

# Usuario de otra empresa / otro tenant.
API_USER_OTROTENANT=
API_PASS_OTROTENANT=

# ─── Pruebas de autenticación ───────────────────────────────────────────────
# Secreto de firma del ambiente de PRUEBAS. Habilita las pruebas de expiración
# y de manipulación de claims (§6 S2 y S10). Sin esto, esas pruebas se saltean
# con motivo en vez de dar un falso verde.
# ⚠️ Jamás el secreto de producción.
# API_JWT_SECRET=

# Alternativa si no se puede compartir el secreto: un token ya vencido.
# API_TOKEN_EXPIRADO=

# ─── Fuente de verdad (capa 3) ──────────────────────────────────────────────
# Conexión de SÓLO LECTURA a la base del ambiente de pruebas.
# Sin esto se usa `fuenteViaApi()`, que es más débil — anotalo en el reporte.
# API_DB_URL=

# ─── Varios ─────────────────────────────────────────────────────────────────
# Identificador de corrida. Se genera solo; fijalo sólo para depurar.
# API_RUN_ID=

# Permite correr contra un host clasificado como producción.
# SÓLO para @smoke de lectura, y anotándolo en el reporte.
# API_PERMITIR_PRODUCCION=1
